+
+/*
+ * Draw the ZIF socket as text, chip at the top, the way Xgpro shows it.
+ * Left column is ZIF pin 1-20 top to bottom, right column is 40-21.
+ */
+static const char *pin_mark(uint8_t st)
+{
+	switch (st) {
+	case 1: return " ok";
+	case 2: return " XX";
+	case 3: return "GND";
+	case 4: return " HI";
+	case 5: return " --";
+	default: return "  .";
+	}
+}
+
+static void t48_print_pin_map(const uint8_t *state, int d_pins)
+{
+	int half = d_pins / 2;
+	int row;
+	fprintf(stderr, "\n");
+	fprintf(stderr, "           +---\\_/---+\n");
+	for (row = 0; row < 20; row++) {
+		int lz = row + 1;
+		int rz = 40 - row;
+		if (row < half) {
+			fprintf(stderr, "  %2d  %s  |%-2d     %2d|  %s  %2d\n",
+				lz, pin_mark(state[lz]), row + 1, d_pins - row,
+				pin_mark(state[rz]), rz);
+		} else {
+			if (row == half)
+				fprintf(stderr, "           +---------+\n");
+			fprintf(stderr, "  %2d  %s               %s  %2d\n",
+				lz, pin_mark(state[lz]), pin_mark(state[rz]), rz);
+		}
+	}
+	if (half >= 20)
+		fprintf(stderr, "           +---------+\n");
+	fprintf(stderr, "  ok = good   XX = bad contact   HI = high with nothing driven\n\n");
+}
+
+/*
+ * Pin contact test for the T48.
+ *
+ * The TL866II+ test uses split pull-up/pull-down banks, which the T48 does
+ * not have. Instead this applies a small positive voltage (about 3.3V, from
+ * the VCC driver) to the device's GND pin(s) while every other pin is an
+ * input with a pull-down. Inside almost any chip, CMOS or NMOS, each pin has
+ * a protection or substrate diode with its anode on GND, so every pin that
+ * really touches the ZIF contact gets pulled up to about 2.7V and reads 1.
+ * A pin with a bad contact keeps reading 0 through its pull-down.
+ *
+ * A baseline read with nothing driven is taken first. A pin that already
+ * reads 1 there is reported as stuck high instead of passed.
+ *
+ * Set MINIPRO_PINTEST_DEBUG=1 to dump the raw readings of all 40 pins.
+ */
+int t48_pin_test(minipro_handle_t *handle)
+{
+	int p_pins = 40;
+	int d_pins = handle->device->package_details.pin_count;
+	int x_pin = d_pins / 2;
+	int pno = p_pins - d_pins;
+	uint8_t base[T48_NPINS], drv[T48_NPINS], msg[64];
+	pin_driver_t pins[T48_NPINS];
+	db_data_t db_data;
+	size_t i, k;
+	int ret = EXIT_FAILURE;
+
+	if (d_pins <= 0 || d_pins > 40) {
+		fprintf(stderr, "Pin test is not supported for this package.\n");
+		return EXIT_SUCCESS;
+	}
+
+	memset(&db_data, 0, sizeof(db_data));
+	db_data.infoic_path = handle->cmdopts->infoic_path;
+	db_data.logicic_path = handle->cmdopts->logicic_path;
+	db_data.index = handle->device->pin_map;
+	pin_map_t *map = get_pin_map(&db_data);
+	if (!map)
+		return EXIT_FAILURE;
+
+	if (!map->gnd_count) {
+		fprintf(stderr, "Pin test: no GND pin known for this device, skipped.\n");
+		free(map);
+		return EXIT_SUCCESS;
+	}
+
+	/* Every GND pin must be reachable by the VCC driver */
+	memset(pins, 0, sizeof(pins));
+	for (i = 0; i < map->gnd_count; i++) {
+		uint16_t g = map->gnd_table[i];
+		int found = 0;
+		for (k = 0; k < sizeof(vcc_pins) / sizeof(vcc_pins[0]); k++)
+			if (vcc_pins[k].pin == g && g <= 40)
+				found = 1;
+		if (!found) {
+			fprintf(stderr, "Pin test is not supported for this package on the T48 (GND on ZIF pin %u).\n", g);
+			free(map);
+			return EXIT_SUCCESS;
+		}
+		pins[g - 1].vcc = 1;
+	}
+
+	/* Baseline: all inputs with pull-downs, nothing driven */
+	if (t48_reset_state(handle))
+		goto cleanup;
+	if (t48_set_input_and_pulldown(handle))
+		goto cleanup;
+	usleep(20000);
+	if (t48_get_zif_state(handle, base))
+		goto cleanup;
+
+	/* Drive about 3.3V onto the GND pin(s) */
+	int v = find_voltage(voltagemap_vcc, sizeof(voltagemap_vcc) / sizeof(float), 3.3, 0.2);
+	if (v < 0)
+		v = 19;
+	if (t48_set_vcc_voltage_and_pins(handle, v, pins, 1))
+		goto cleanup;
+	usleep(300000);
+
+	memset(msg, 0, sizeof(msg));
+	msg[0] = T48_READ_PINS;
+	if (msg_send(handle->usb_handle, msg, 8))
+		goto cleanup;
+	if (msg_recv(handle->usb_handle, msg, sizeof(msg)))
+		goto cleanup;
+	for (i = 0; i < T48_NPINS; i++)
+		drv[i] = (msg[8 + (i >> 3)] >> (i & 7)) & 1;
+	int overcurrent = msg[1];
+
+	/* Drivers off again before anything else happens */
+	t48_reset_state(handle);
+
+	if (getenv("MINIPRO_PINTEST_DEBUG")) {
+		fprintf(stderr, "ZIF pin:  ");
+		for (i = 0; i < 40; i++)
+			fprintf(stderr, "%u", (unsigned)((i + 1) % 10));
+		fprintf(stderr, "\nbaseline: ");
+		for (i = 0; i < 40; i++)
+			fprintf(stderr, "%u", base[i]);
+		fprintf(stderr, "\ndriven:   ");
+		for (i = 0; i < 40; i++)
+			fprintf(stderr, "%u", drv[i]);
+		fprintf(stderr, "\nGND pins:");
+		for (i = 0; i < map->gnd_count; i++)
+			fprintf(stderr, " %u", map->gnd_table[i]);
+		fprintf(stderr, "\n");
+	}
+
+	if (overcurrent) {
+		fprintf(stderr, "Pin test: overcurrent while driving the GND pin. Is the chip in the right way round?\n");
+		goto cleanup;
+	}
+
+	/* Per ZIF pin result for the drawing: 0 not under the chip, 1 ok,
+	 * 2 bad contact, 3 GND (the pin being driven), 4 high with nothing
+	 * driven, 5 under the chip but not tested */
+	uint8_t state[41];
+	memset(state, 0, sizeof(state));
+	for (i = 1; i <= 40; i++)
+		if ((int)i <= x_pin || (int)i > 40 - x_pin)
+			state[i] = 5;
+
+	ret = EXIT_SUCCESS;
+	for (i = 0; i < map->mask_count; i++) {
+		int p_pin = map->mask[i];
+		int d_pin = p_pin > x_pin ? p_pin - pno : p_pin;
+		int is_gnd = 0;
+		if (p_pin < 1 || p_pin > 40)
+			continue;
+		for (k = 0; k < map->gnd_count; k++)
+			if (map->gnd_table[k] == p_pin)
+				is_gnd = 1;
+		if (is_gnd) {
+			state[p_pin] = 3;
+			continue;
+		}
+		if (base[p_pin - 1]) {
+			fprintf(stderr, "Pin %u reads high with nothing driven (shorted to something?)\n", d_pin);
+			state[p_pin] = 4;
+			ret = EXIT_FAILURE;
+		} else if (!drv[p_pin - 1]) {
+			fprintf(stderr, "Bad contact on pin:%u\n", d_pin);
+			state[p_pin] = 2;
+			ret = EXIT_FAILURE;
+		} else {
+			state[p_pin] = 1;
+		}
+	}
+	for (i = 0; i < map->gnd_count; i++)
+		if (map->gnd_table[i] >= 1 && map->gnd_table[i] <= 40)
+			state[map->gnd_table[i]] = 3;
+
+	t48_print_pin_map(state, d_pins);
+
+	if (!ret)
+		fprintf(stderr, "Pin test passed.\n");
+
+cleanup:
+	t48_reset_state(handle);
+	free(map);
+	return ret;
+}
