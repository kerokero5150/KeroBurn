 /* Wrappers for operating with files */
+/*
+ * --offset / --file_offset / --length / --keep
+ *
+ * Copy part of a raw binary file into buf (the chip image, size bytes) at
+ * place_offset. Without --keep the rest of buf stays at the blank value,
+ * with --keep the caller has already filled buf with the chip contents.
+ * Only plain binary files are accepted; hex and srec carry their own
+ * addresses.
+ */
+static int place_file(minipro_handle_t *handle, uint8_t *buf, size_t size,
+		      size_t *start, size_t *length)
+{
+	cmdopts_t *o = handle->cmdopts;
+	struct stat st;
+	FILE *file;
+
+	if (o->is_pipe) {
+		fprintf(stderr, "--offset/--keep can't be used with a pipe.\n");
+		return EXIT_FAILURE;
+	}
+	if (o->format != NO_FORMAT) {
+		fprintf(stderr, "--offset/--keep only work with binary files.\n");
+		return EXIT_FAILURE;
+	}
+	file = fopen(o->filename, "rb");
+	if (!file || stat(o->filename, &st)) {
+		fprintf(stderr, "Could not open file %s for reading.\n",
+			o->filename);
+		if (file)
+			fclose(file);
+		return EXIT_FAILURE;
+	}
+	size_t fsize = st.st_size;
+	if (o->place_file_offset >= fsize) {
+		fprintf(stderr,
+			"File offset 0x%X is past the end of the file (%zu bytes).\n",
+			o->place_file_offset, fsize);
+		fclose(file);
+		return EXIT_FAILURE;
+	}
+	size_t len = o->place_length ? o->place_length :
+				       fsize - o->place_file_offset;
+	if (o->place_file_offset + len > fsize) {
+		fprintf(stderr,
+			"File is too short: 0x%zX bytes from 0x%X needed, file has %zu bytes.\n",
+			len, o->place_file_offset, fsize);
+		fclose(file);
+		return EXIT_FAILURE;
+	}
+	if (o->place_offset + len > size) {
+		fprintf(stderr,
+			"Doesn't fit: 0x%zX bytes at 0x%X goes past the end of the chip (0x%zX).\n",
+			len, o->place_offset, size);
+		fclose(file);
+		return EXIT_FAILURE;
+	}
+	if (fseek(file, o->place_file_offset, SEEK_SET) ||
+	    fread(buf + o->place_offset, 1, len, file) != len) {
+		fprintf(stderr, "Could not read %s.\n", o->filename);
+		fclose(file);
+		return EXIT_FAILURE;
+	}
+	fclose(file);
+	*start = o->place_offset;
+	*length = len;
+	return EXIT_SUCCESS;
+}
